APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/phr
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Material estático del servidor OPAQUE (docs/OPAQUE.md §12.2).
# Se genera con `php artisan opaque:setup`; sin él la aplicación no arranca.
# Perfil criptográfico único; debe ser OPAQUE-R255-SHA512-A2ID-m65536-t3-p4-ctx0-v1.
OPAQUE_PROFILE=
# Semilla de la que se derivan las claves OPRF de cada usuario; base64url de 64 bytes.
OPAQUE_OPRF_SEED=
# Escalar estático del servidor (la clave privada ya derivada, no la semilla); base64url de 32 bytes.
OPAQUE_SERVER_PRIVATE_KEY=
# Opcional: copia de la clave pública para contrastarla con la derivada del escalar; base64url de 32 bytes.
OPAQUE_SERVER_PUBLIC_KEY=
# Registro ficticio de la rama anti-enumeración (§13.2); base64url de 192 bytes.
OPAQUE_FAKE_REGISTRATION_RECORD=
# Identidad del servidor; debe coincidir carácter a carácter con `identifiers.server` del cliente.
# Es un identificador de despliegue, NO una URL ni el dominio: se elige una sola vez y no se cambia
# jamás, porque entra en el preámbulo del handshake OPAQUE, y cambiarlo deja a TODAS las cuentas sin
# poder iniciar sesión. El dominio (APP_URL) sí puede cambiar libremente sin tocar este valor; son
# cosas distintas justamente para permitirlo.
OPAQUE_SERVER_IDENTITY=
# Clave del HMAC del credential_identifier (§13.1); base64url de 32 bytes, distinta de APP_KEY y del oprf_seed.
OPAQUE_ENUMERATION_KEY=
# Contexto del preamble; vacío en este perfil (ctx0) y no se debe rellenar.
OPAQUE_CONTEXT=

# --- Compartición de recortes con un profesional (ADR 0011) -------------------------------------
# Clave del HMAC de la sal señuelo del `challenge`; base64url de 32 bytes.
# Cuando un enlace no existe, caducó o se revocó, el servidor devuelve igualmente una sal derivada de
# esta clave sobre el identificador, para que un enlace muerto sea indistinguible de uno vivo. Tiene
# entrada propia y NO cuelga de APP_KEY: APP_KEY la rota cualquiera al reinstalar, y con ella
# cambiaría la sal señuelo de un identificador dado, lo que volvería a distinguir muertos de vivos
# comparando dos despliegues. Si se deja vacía se usa OPAQUE_ENUMERATION_KEY, que cumple el mismo
# papel en el login; si tampoco está, el `challenge` falla en voz alta en lugar de degradarse.
SHARE_DECOY_SALT_KEY=
